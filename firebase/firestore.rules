rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esMiembroDelGrupo(grupoId) {
      return estaAutenticado() &&
        request.auth.uid in get(/databases/$(database)/documents/grupos/$(grupoId)).data.miembros;
    }

    function esCreadorDelGrupo(grupoId) {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/grupos/$(grupoId)).data.creadoPor == request.auth.uid;
    }

    // Alta por invitación (sin Cloud Function): un usuario que TODAVÍA NO
    // es miembro puede escribir en /grupos/{grupoId} únicamente para
    // agregarse a sí mismo, y solo si cita (en el propio update, campo
    // ultimaInvitacionToken) una invitación real, vigente y con cupo para
    // ESE grupo puntual. `miembros.size() == +1` asegura que la escritura
    // agrega exactamente un integrante (a los ya existentes, que se
    // conservan intactos vía hasAll) y no borra ni reemplaza a nadie más.
    function esAltaPorInvitacionValida(grupoId, miembrosAntes) {
      let token = request.resource.data.ultimaInvitacionToken;
      let invitacion = get(/databases/$(database)/documents/invitaciones/$(token)).data;
      return estaAutenticado() &&
        !(request.auth.uid in miembrosAntes) &&
        request.auth.uid in request.resource.data.miembros &&
        request.resource.data.miembros.size() == miembrosAntes.size() + 1 &&
        request.resource.data.miembros.hasAll(miembrosAntes) &&
        invitacion.grupoId == grupoId &&
        invitacion.expiraEn > request.time &&
        (invitacion.usosMaximos == null || invitacion.usosActuales < invitacion.usosMaximos);
    }

    // --- usuarios ---
    // Cada usuario solo puede leer y escribir su propio perfil.
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && request.auth.uid == uid;
      allow create: if estaAutenticado() && request.auth.uid == uid;
      allow update: if estaAutenticado() && request.auth.uid == uid;
      allow delete: if false;
    }

    // --- grupos ---
    match /grupos/{grupoId} {
      // OJO: acá se compara directo contra resource.data.miembros (sin la
      // función esMiembroDelGrupo, que hace un get() extra). Para reglas de
      // *listado* (queries), Firestore necesita poder evaluar la condición
      // sin ir a buscar el documento de nuevo; usar get() sobre el mismo
      // documento que se está listando puede hacer que rechace la consulta
      // entera con permission-denied, incluso cuando el resultado sería
      // válido. Fuera de listados (subcolecciones más abajo) sí es seguro
      // usar esMiembroDelGrupo, porque ahí el get() apunta al documento
      // *padre*, no al que se está evaluando.
      allow read: if estaAutenticado() && request.auth.uid in resource.data.miembros;
      allow create: if estaAutenticado() &&
        request.auth.uid == request.resource.data.creadoPor &&
        request.auth.uid in request.resource.data.miembros;
      // Un miembro puede actualizar libremente. Alguien que TODAVÍA NO es
      // miembro solo puede escribir para agregarse a sí mismo citando una
      // invitación válida (ver esAltaPorInvitacionValida arriba).
      allow update: if estaAutenticado() && (
        request.auth.uid in resource.data.miembros ||
        esAltaPorInvitacionValida(grupoId, resource.data.miembros)
      );
      allow delete: if estaAutenticado() && resource.data.creadoPor == request.auth.uid;

      // --- gastos (subcolección) ---
      match /gastos/{gastoId} {
        allow read: if esMiembroDelGrupo(grupoId);
        allow create: if esMiembroDelGrupo(grupoId) &&
          request.auth.uid == request.resource.data.creadoPor;
        allow update, delete: if esMiembroDelGrupo(grupoId);
      }

      // --- prestamos (subcolección) ---
      match /prestamos/{prestamoId} {
        allow read: if esMiembroDelGrupo(grupoId);
        allow create: if esMiembroDelGrupo(grupoId) &&
          request.auth.uid == request.resource.data.creadoPor;
        // Solo prestamista o prestatario pueden marcar cuotas / actualizar el préstamo.
        allow update: if esMiembroDelGrupo(grupoId) &&
          (request.auth.uid == resource.data.prestamista ||
           request.auth.uid == resource.data.prestatario);
        allow delete: if esMiembroDelGrupo(grupoId) &&
          request.auth.uid == resource.data.prestamista;
      }

      // --- pagos (subcolección) ---
      // Ciclo de vida de un pago real (trazabilidad completa):
      //   - CREAR: el DEUDOR declara que envió dinero ("declarado"), o se
      //     conserva el alta legacy del ACREEDOR confirmando directo (sin
      //     estado) para no romper los registros ya creados por la versión
      //     vieja. Nunca de == para.
      //   - La deuda NO se considera saldada en el create: la confirmación
      //     real llega recién con el update del acreedor.
      //   - UPDATE (máquina de estados, con el rol correcto por transición):
      //       declarado -> confirmado : SOLO el acreedor (para)
      //       declarado -> rechazado  : SOLO el acreedor (para)
      //       declarado -> cancelado  : SOLO el deudor (de), mientras siga
      //                                 pendiente de confirmación
      //   - DELETE: solo para deshacer un "recibido" legacy (lo creó el
      //     acreedor) o una declaración propia todavía no confirmada.
      match /pagos/{pagoId} {
        allow read: if esMiembroDelGrupo(grupoId);
        allow create: if esMiembroDelGrupo(grupoId) &&
          request.resource.data.de != request.resource.data.para &&
          (
            (request.resource.data.de == request.auth.uid &&
             request.resource.data.estado == "declarado") ||
            (request.resource.data.para == request.auth.uid)
          );
        allow update: if esMiembroDelGrupo(grupoId) && (
          (resource.data.estado == "declarado" &&
           request.resource.data.estado == "confirmado" &&
           request.auth.uid == resource.data.para) ||
          (resource.data.estado == "declarado" &&
           request.resource.data.estado == "rechazado" &&
           request.auth.uid == resource.data.para) ||
          (resource.data.estado == "declarado" &&
           request.resource.data.estado == "cancelado" &&
           request.auth.uid == resource.data.de)
        );
        allow delete: if esMiembroDelGrupo(grupoId) && (
          resource.data.confirmadoPor == request.auth.uid ||
          (resource.data.estado == "declarado" &&
           resource.data.de == request.auth.uid)
        );
      }

      // --- liquidaciones (subcolección) ---
      // Snapshot de cierre de una liquidación: lo crea cualquier miembro
      // (queda grabado quién cerró), y una vez escrito queda inmutable.
      match /liquidaciones/{liquidacionId} {
        allow read: if esMiembroDelGrupo(grupoId);
        allow create: if esMiembroDelGrupo(grupoId) &&
          request.resource.data.cerradoPor == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // --- invitaciones ---
    // Lectura pública controlada: cualquier autenticado (incluso anónimo recién
    // creado) puede leer una invitación para validar el token, pero nunca listarlas.
    match /invitaciones/{token} {
      allow get: if estaAutenticado();
      allow list: if false;
      allow create: if esCreadorDelGrupo(request.resource.data.grupoId);
      // Cualquier autenticado puede incrementar usosActuales EN EXACTAMENTE
      // 1 (y solo ese campo), siempre que la invitación no esté vencida ni
      // agotada — es el paso que consumirInvitacion() hace al aceptar una
      // invitación. No puede tocar ningún otro campo (grupoId, creadoPor,
      // expiraEn, usosMaximos quedan protegidos).
      allow update: if estaAutenticado() &&
        resource.data.expiraEn > request.time &&
        (resource.data.usosMaximos == null || resource.data.usosActuales < resource.data.usosMaximos) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usosActuales"]) &&
        request.resource.data.usosActuales == resource.data.usosActuales + 1;
      allow delete: if esCreadorDelGrupo(resource.data.grupoId);
    }
  }
}
