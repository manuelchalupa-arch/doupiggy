rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esMiembroDelGrupo(grupoId) {
      return estaAutenticado() &&
        request.auth.uid in get(/databases/$(database)/documents/grupos/$(grupoId)).data.miembros;
    }

    function esCreadorDelGrupo(grupoId) {
      return estaAutenticado() &&
        get(/databases/$(database)/documents/grupos/$(grupoId)).data.creadoPor == request.auth.uid;
    }

    // --- usuarios ---
    // Cada usuario solo puede leer y escribir su propio perfil.
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && request.auth.uid == uid;
      allow create: if estaAutenticado() && request.auth.uid == uid;
      allow update: if estaAutenticado() && request.auth.uid == uid;
      allow delete: if false;
    }

    // --- grupos ---
    match /grupos/{grupoId} {
      // OJO: acá se compara directo contra resource.data.miembros (sin la
      // función esMiembroDelGrupo, que hace un get() extra). Para reglas de
      // *listado* (queries), Firestore necesita poder evaluar la condición
      // sin ir a buscar el documento de nuevo; usar get() sobre el mismo
      // documento que se está listando puede hacer que rechace la consulta
      // entera con permission-denied, incluso cuando el resultado sería
      // válido. Fuera de listados (subcolecciones más abajo) sí es seguro
      // usar esMiembroDelGrupo, porque ahí el get() apunta al documento
      // *padre*, no al que se está evaluando.
      allow read: if estaAutenticado() && request.auth.uid in resource.data.miembros;
      allow create: if estaAutenticado() &&
        request.auth.uid == request.resource.data.creadoPor &&
        request.auth.uid in request.resource.data.miembros;
      // Solo un miembro puede actualizar (ej. agregar a otro miembro vía invitación
      // se hace con una Cloud Function con privilegios elevados, ver Bloque 2).
      allow update: if estaAutenticado() && request.auth.uid in resource.data.miembros;
      allow delete: if estaAutenticado() && resource.data.creadoPor == request.auth.uid;

      // --- gastos (subcolección) ---
      match /gastos/{gastoId} {
        allow read: if esMiembroDelGrupo(grupoId);
        allow create: if esMiembroDelGrupo(grupoId) &&
          request.auth.uid == request.resource.data.creadoPor;
        allow update, delete: if esMiembroDelGrupo(grupoId);
      }

      // --- prestamos (subcolección) ---
      match /prestamos/{prestamoId} {
        allow read: if esMiembroDelGrupo(grupoId);
        allow create: if esMiembroDelGrupo(grupoId) &&
          request.auth.uid == request.resource.data.creadoPor;
        // Solo prestamista o prestatario pueden marcar cuotas / actualizar el préstamo.
        allow update: if esMiembroDelGrupo(grupoId) &&
          (request.auth.uid == resource.data.prestamista ||
           request.auth.uid == resource.data.prestatario);
        allow delete: if esMiembroDelGrupo(grupoId) &&
          request.auth.uid == resource.data.prestamista;
      }
    }

    // --- invitaciones ---
    // Lectura pública controlada: cualquier autenticado (incluso anónimo recién
    // creado) puede leer una invitación para validar el token, pero nunca listarlas.
    match /invitaciones/{token} {
      allow get: if estaAutenticado();
      allow list: if false;
      allow create: if esCreadorDelGrupo(request.resource.data.grupoId);
      // La actualización de usosActuales se hace vía Cloud Function (transacción
      // atómica) para evitar condiciones de carrera; el cliente no escribe directo.
      allow update: if false;
      allow delete: if esCreadorDelGrupo(resource.data.grupoId);
    }
  }
}
